NODE_ENV=production
APP_PORT=3000
APP_TIMEZONE=Asia/Yekaterinburg
POSTGRES_DB=fssp
POSTGRES_USER=fssp
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://fssp:replace-with-a-long-random-value@localhost:5432/fssp
DOCUMENTS_ROOT=/var/lib/fssp/documents
ALLOW_BOOTSTRAP=false
# Для первого администратора временно включите true, затем обязательно верните false.
COOKIE_SECURE=false
# За HTTPS на AdminVPS установите true; для локального HTTP оставьте false.
DOCUMENT_MAX_BYTES=26214400
